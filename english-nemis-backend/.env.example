NODE_ENV=development
PORT=4000

# MongoDB — Atlas or local
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/english-nemis-learning

# Auth
JWT_SECRET=change_me_to_a_random_32_plus_char_secret
WEB_URL=http://localhost:3003

# Seed admin (used by `pnpm seed:admin`)
SEED_ADMIN_EMAIL=admin@linguacoach.ai
SEED_ADMIN_NAME=LinguaCoach Admin
SEED_ADMIN_PASSWORD=change_me

# AI providers — at least one is required
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Cloudflare R2 for listening audio storage (optional — scraper falls back to source URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=        # e.g. https://cdn.linguacoach.ai   (if you set a custom domain on the bucket)
